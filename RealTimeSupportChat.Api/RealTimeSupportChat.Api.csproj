<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Swagger\index.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RealTimeSupportChat.Application\RealTimeSupportChat.Application.csproj" />
    <ProjectReference Include="..\RealTimeSupportChat.Identity\RealTimeSupportChat.Identity.csproj" />
    <ProjectReference Include="..\RealTimeSupportChat.Infrastructure\RealTimeSupportChat.Infrastructure.csproj" />
    <ProjectReference Include="..\RealTimeSupportChat.Persistence\RealTimeSupportChat.Persistence.csproj" />
  </ItemGroup>

</Project>
